[Unit]
Description=HomeLab Dashboard manuell aktualisieren
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-dashboard-manual-update
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/homelab-dashboard /run/homelab-dashboard /run/lock /etc/systemd/system /etc/nginx/sites-available /usr/local/sbin
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Environment=HOME=/tmp
Environment=NPM_CONFIG_CACHE=/tmp/npm-cache
